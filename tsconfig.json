{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "bookmarks.ts", "demo.ts", "favourites.ts", "liquid.ts", "panel.ts", "ui.ts", "websites.ts"],
  "exclude": ["src/react.tsx"]
}
